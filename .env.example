# East Africa tourism image system — provider credentials.
#
# These keys are read ONLY by the Node scripts under tourism/scripts/ at build
# time. They are never written into the generated HTML, never referenced by any
# browser script, and never committed. Copy this file to `.env` and fill it in.
#
# Unsplash is the primary provider. Register an application at
# https://unsplash.com/developers and use the "Access Key" (not the secret).
UNSPLASH_ACCESS_KEY=

# Pexels is the fallback provider. Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=
